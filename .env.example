# SideKick needs ONE of these (model is gpt-6-luna either way). If both are set, OPENAI_API_KEY is
# tried first and PORTKEY_API_KEY takes over if that key is rejected or lacks the model.
# Put it in .env in this folder, or in the .env one folder up.
OPENAI_API_KEY=
PORTKEY_API_KEY=

# Optional (defaults are the public SideKick Supabase project; safe to leave unset):
# SIDEKICK_SUPABASE_URL=https://oewmzdttlqspfxnbpgfh.supabase.co
# SIDEKICK_SUPABASE_KEY=sb_publishable_...
# ALLOWED_ORIGINS=https://your-frontend.example
